{
  "name": "@soamee/exceptions-filter",
  "version": "1.5.1",
  "description": "Configurable NestJS global exception filter with skip patterns, sanitization, crawler detection, and DB persistence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "require": "./dist/client-sdk/index.js",
      "types": "./dist/client-sdk/index.d.ts"
    },
    "./client/web": {
      "require": "./dist/client-sdk/web.js",
      "types": "./dist/client-sdk/web.d.ts"
    },
    "./client/react": {
      "require": "./dist/client-sdk/react.js",
      "types": "./dist/client-sdk/react.d.ts"
    },
    "./client/react-native": {
      "require": "./dist/client-sdk/react-native.js",
      "types": "./dist/client-sdk/react-native.d.ts"
    }
  },
  "bin": {
    "upload-sourcemaps": "./dist/cli/upload-sourcemaps.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pack:check": "npm run build && node scripts/check-package.js"
  },
  "keywords": [
    "nestjs",
    "exception-filter",
    "error-handling",
    "express"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soamee/exceptions-filter"
  },
  "dependencies": {
    "date-fns": "^3.0.0 || ^4.0.0",
    "source-map": "^0.7.6"
  },
  "peerDependencies": {
    "@casl/ability": ">=5.0.0",
    "@aws-sdk/client-s3": ">=3.0.0",
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "@nestjs/platform-express": ">=9.0.0",
    "@prisma/client": ">=4.0.0",
    "@sentry/nestjs": ">=7.0.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "express": ">=4.0.0",
    "reflect-metadata": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@sentry/nestjs": {
      "optional": true
    },
    "@casl/ability": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "@nestjs/platform-express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.0.0",
    "@types/jest": "^29.0.0",
    "@types/supertest": "^7.2.1",
    "express": "^4.21.0",
    "jest": "^29.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
